# ── NETRA configuration (copy to .env; never commit .env) ────────────────
NETRA_ENV=development
NETRA_LOG_LEVEL=info
NETRA_LOG_FORMAT=json

# ── Backend HTTP ─────────────────────────────────────────────────────────
NETRA_HTTP_ADDR=:8080
NETRA_HTTP_READ_TIMEOUT=15s
NETRA_HTTP_WRITE_TIMEOUT=30s
NETRA_HTTP_SHUTDOWN_TIMEOUT=15s
NETRA_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── PostgreSQL ───────────────────────────────────────────────────────────
# Secrets are left blank on purpose. `make env` generates a random value for
# each one; a committed default password is the first thing an attacker tries.
NETRA_DATABASE_URL=postgres://netra:CHANGE_ME@localhost:5432/netra?sslmode=disable
NETRA_DB_MAX_CONNS=10
NETRA_DB_MIN_CONNS=1
NETRA_DB_AUTO_MIGRATE=true

# Used only by docker compose to initialise the postgres container.
POSTGRES_USER=netra
POSTGRES_PASSWORD=
POSTGRES_DB=netra

# ── OIDC (Keycloak in development) ───────────────────────────────────────
# Wired in Phase 2. Present here so configuration is externalised from day one.
NETRA_OIDC_ISSUER=http://localhost:8081/realms/netra
NETRA_OIDC_CLIENT_ID=netra-client
NETRA_OIDC_AUDIENCE=netra-backend
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Password applied to the imported demo users by
# deployment/keycloak/set-demo-passwords.sh. The realm import contains no
# credentials, so this must be set before the demo users can sign in.
NETRA_DEMO_PASSWORD=

# Locally minted development tokens. Refused unless NETRA_ENV=development.
# Keeps integration tests and the demonstration working without Keycloak.
NETRA_DEV_AUTH_ENABLED=false
NETRA_DEV_AUTH_TTL=1h

# ── Risk engine (Phase 7) — thresholds are configuration, never constants ─
NETRA_RISK_THRESHOLD_LOW=30
NETRA_RISK_THRESHOLD_MEDIUM=50
NETRA_RISK_THRESHOLD_ELEVATED=70
NETRA_RISK_THRESHOLD_HIGH=85

# ── Device posture scoring ───────────────────────────────────────────────
# Weights must sum to 100; the backend refuses to start otherwise, because a
# score that is not out of 100 is not interpretable as one.
NETRA_POSTURE_WEIGHT_DEVICE_IDENTITY=20
NETRA_POSTURE_WEIGHT_AGENT_HEALTH=15
NETRA_POSTURE_WEIGHT_DISK_ENCRYPTION=20
NETRA_POSTURE_WEIGHT_SECURE_BOOT=15
NETRA_POSTURE_WEIGHT_OS_SUPPORTED=10
NETRA_POSTURE_WEIGHT_FIREWALL=10
NETRA_POSTURE_WEIGHT_SCREEN_LOCK=5
NETRA_POSTURE_WEIGHT_ANTI_MALWARE=5
# Agents on an older build score partial agent health.
NETRA_EXPECTED_AGENT_VERSION=0.1.0

# ── Agent (Phase 3+) ─────────────────────────────────────────────────────
NETRA_BACKEND_URL=http://localhost:8080
NETRA_AGENT_HEARTBEAT_INTERVAL=30s
# Posture probes spawn system utilities, so they run far less often.
NETRA_AGENT_POSTURE_INTERVAL=10m
NETRA_AGENT_QUEUE_MAX_EVENTS=10000
NETRA_AGENT_QUEUE_MAX_BYTES=20971520

# ── Published host ports ─────────────────────────────────────────────────
# Override any of these if the default is already taken on your machine.
NETRA_POSTGRES_PORT=5432
NETRA_BACKEND_PORT=8080
NETRA_DASHBOARD_PORT=8090
NETRA_KEYCLOAK_PORT=8081

# API URL baked into the dashboard image at build time (browser-visible).
NETRA_PUBLIC_API_URL=http://localhost:8080
