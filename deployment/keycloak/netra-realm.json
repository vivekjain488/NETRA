{
  "realm": "netra",
  "displayName": "NETRA",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "failureFactor": 5,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "USER", "description": "Ordinary endpoint user. May view their own security state." },
      { "name": "SECURITY_ANALYST", "description": "Investigates incidents in the SOC console." },
      { "name": "ADMIN", "description": "Manages devices, policies and enrollment." },
      { "name": "AUDITOR", "description": "Reads the audit log. Cannot act." }
    ]
  },
  "defaultRoles": ["USER"],
  "clients": [
    {
      "clientId": "netra-client",
      "name": "NETRA endpoint client",
      "description": "Electron desktop client. Public client using authorization code with PKCE.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1/*"
      },
      "redirectUris": ["http://127.0.0.1/*", "http://localhost/*"],
      "webOrigins": ["+"],
      "protocolMappers": [
        {
          "name": "netra-backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "netra-backend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "department",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "department",
            "claim.name": "department",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "netra-backend",
      "name": "NETRA control plane",
      "description": "Resource server. Exists so tokens carry an audience the backend can validate.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice.sharma@example.gov",
      "firstName": "Alice",
      "lastName": "Sharma",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "department": ["Operations"] },
      "realmRoles": ["USER"]
    },
    {
      "username": "ravi",
      "email": "ravi.menon@example.gov",
      "firstName": "Ravi",
      "lastName": "Menon",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "department": ["Security Operations"] },
      "realmRoles": ["USER", "SECURITY_ANALYST"]
    },
    {
      "username": "priya",
      "email": "priya.nair@example.gov",
      "firstName": "Priya",
      "lastName": "Nair",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "department": ["Platform Administration"] },
      "realmRoles": ["USER", "ADMIN"]
    },
    {
      "username": "arun",
      "email": "arun.desai@example.gov",
      "firstName": "Arun",
      "lastName": "Desai",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "department": ["Internal Audit"] },
      "realmRoles": ["USER", "AUDITOR"]
    }
  ]
}
